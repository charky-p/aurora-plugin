#rank.sk
# Staff ranks: owner, [manager, senior_admin, co-owner], [admin, senior_mod], head_dev, head_builder, dev, mod, junior_mod, builder, helper, trainee
# Donator ranks: Luminary, Celestial, Aurora
# Donator packages: Luminary (supporter, donor, investor, VIP), Celestial (rich, patron, VIP+, MVP), Aurora (MVP+, maestro)

# donor suffix: supporter, donor, investor, rich, patron, VIP, VIP+, MVP, MVP+, maestro
# Player playtime suffixes: new, regular, veteran
# Player upgradable suffixes: N/A advanced, elite, legend, titan, immortal, divine, eternal, ultimate, supreme, legendary, champion, collosal, hero, warrior, apex, invincible, nexus, radiant, paragon, ascendant
# misc suffixes: overworld, caverns, etc.
# more misc suffixes: angelic, demonic, beast, spirit, archangel, christmas 2023, halloween 2023, etc overlord, soverign
# fishing/ ranks: beginner, novice, rookie, amateur, apprentice, intermediate, adept, experienced, skilled, advanced, proficient, expert, veteran, elite, master, grandmaster

# COMMANDS --------------------------------------------------------------------------------
command /rank <player> <text> <text>:
	permission: op
	cooldown: 1 second
	usage: /rank <player> <type> <rank>
	trigger:
		if arg-2 is "staff":
			if {TstaffRankList::*} contains arg-3:
				set {rank::%arg-1's uuid%::%arg-3%} to true
				send "&7%arg-1% now has %arg-3% rank" to player
		else if arg-2 is "donor":
			if {TdonorRankList::*} contains arg-3:
				set {rank::%arg-1's uuid%::%arg-3%} to true
				send "&7%arg-1% now has %arg-3% rank" to player
		else if arg-2 is "player":
			if {TplayerRankList::*} contains arg-3:
				set {rank::%arg-1's uuid%::%arg-3%} to true
				send "&7%arg-1% now has %arg-3% rank" to player

command /unrank <player> <text> <text>:
	permission: op
	cooldown: 1 second
	usage: /unrank <player> <type> <rank>
	trigger:
		if arg-2 is "staff":
			if {TstaffRankList::*} contains arg-3:
				set {rank::%arg-1's uuid%::%arg-3%} to false
				send "&7%arg-1% no longer has %arg-3% rank" to player
		else if arg-2 is "donor":
			if {TdonorRankList::*} contains arg-3:
				set {rank::%arg-1's uuid%::%arg-3%} to false
				send "&7%arg-1% no longer has %arg-3% rank" to player
		else if arg-2 is "player":
			if {TplayerRankList::*} contains arg-3:
				set {rank::%arg-1's uuid%::%arg-3%} to false
				send "&7%arg-1% no longer has %arg-3% rank" to player

command /checkrank <player> <text>:
	permission: op
	cooldown: 1 second
	usage: /checkrank <player> <rank>
	trigger:
		if {rank::%arg-1's uuid%::%arg-2%} is true:
			send "&7%arg-1% has %arg-2% rank" to player
		else:
			send "&7%arg-1% does not have %arg-2% rank" to player

command /suffix <player> <text>:
	permission: op
	cooldown: 1 second
	usage: /suffix <player> <suffix>
	trigger:
		if {suffixesList::*} contains arg-2:
			set {suffix::%arg-1's uuid%::%arg-2%} to true
			send "&7%arg-1% now has %arg-2% suffix" to player
		else:
			send "&7Invalid suffix" to player

command /removesuffix <player> <text>:
	permission: op
	cooldown: 1 second
	usage: /removesuffix <player> <suffix>
	trigger:
		if {suffixesList::*} contains arg-2:
			set {suffix::%arg-1's uuid%::%arg-2%} to false
			send "&7%arg-1% no longer has %arg-2% suffix" to player
		else:
			send "&7Invalid suffix" to player

command /checksuffix <player> <text>:
	permission: op
	cooldown: 1 second
	usage: /checksuffix <player> <suffix>
	trigger:
		if {suffixesList::*} contains arg-2:
			if {suffix::%arg-1's uuid%::%arg-2%} is true:
				send "&7%arg-1% has %arg-2% suffix" to player
			else:
				send "&7%arg-1% does not have %arg-2% suffix" to player
		else:
			send "&7Invalid suffix" to player

command /customise:
	trigger:
		openGui("Customise", player)
		set slot 4 of player's current inventory to book named "&b&lInfo" with lore "&7Customise your chat format and tablist"
		set slot 20 of player's current inventory to nametag of mending with all flags hidden named "&e&lRANKS"
		set slot 22 of player's current inventory to lime stained glass pane of mending with all flags hidden named "&7[&lSUFFIXES&7]"
		set slot 24 of player's current inventory to blue dye of mending with all flags hidden named "&c&lC&6&lh&e&la&a&lt &9&lC&5&lo&d&ll&c&lo&6&lr&e&ls"

command /donor <player> <text>:
	permission: op
	usage: /donor <player> <add|remove>
	trigger:
		if arg-2 is "add":
			set {suffix2Perms::%arg-1's uuid%} to true
			send "&7%arg-1% now has suffix 2 perms"
		else if arg-2 is "remove":
			set {suffix2Perms::%arg-1's uuid%} to false
			send "&7%arg-1% no longer has suffix 2 perm"

command /color <player> <text>:
	permission: op
	usage: /color <player> <color>
	trigger:
		loop {colorsList::*}:
			if arg-2 is loop-value:
				set {color::%player's uuid%::%loop-value%} to true
				send "&7%arg-1% now has %{color::%loop-value%}%%arg-2% color" to player
		if {colorsList::*} does not contain arg-2:
			send "&7Invalid Color" to player

command /uncolor <player> <text>:
	permission: op
	usage: /uncolor <player> <color>
	trigger:
		loop {colorsList::*}:
			if arg-2 is loop-value:
				delete {color::%player's uuid%::%loop-value%}
				send "&7%arg-1% no longer has %{color::%loop-value%}%%arg-2% color" to player
		if {colorsList::*} does not contain arg-2:
			send "&7Invalid Color" to player

command /var [<text>]:
	permission: op
	usage: /var reset
	trigger:
		if arg-1 is "reset":
			set {suffixesList::*} to "new", "regular", "veteran", "supporter", "donor", "investor", "rich", "patron", "maestro", "VIP", "VIP+", "MVP" and "MVP+"
			set {suffix::supporter} to "&a[SUPPORTER]"
			set {suffix::donor} to "&5[DONOR]"
			set {suffix::investor} to "&a[INVESTOR]"
			set {suffix::rich} to "&a[$RICH$]"
			set {suffix::patron} to "&d[PATRON]"
			set {suffix::maestro} to "&6[MAESTRO]"
			set {suffix::VIP} to "&2[VIP]"
			set {suffix::VIP+} to "&2[VIP+]"
			set {suffix::MVP} to "&b[MVP]"
			set {suffix::MVP+} to "&b[MVP+]"
			set {suffix::new} to "&7[&8NEW&7]"
			set {suffix::regular} to "&7[&8REGULAR&7]"
			set {suffix::veteran} to "&7[&8VETERAN&7]"
			set {suffix::description::supporter} to "&7Obtainable through the Luminary Donor Package with /buy"
			set {suffix::description::donor} to "&7Obtainable through the Luminary Donor Package with /buy"
			set {suffix::description::investor} to "&7Obtainable through the Luminary Donor Package with /buy"
			set {suffix::description::VIP} to "&7Obtainable through the Luminary Donor Package with /buy"
			set {suffix::description::rich} to "&7Obtainable through the Celestial Donor Package with /buy"
			set {suffix::description::patron} to "&7Obtainable through the Celestial Donor Package with /buy"
			set {suffix::description::VIP+} to "&7Obtainable through the Celestial Donor Package with /buy"
			set {suffix::description::MVP} to "&7Obtainable through the Celestial Donor Package with /buy"
			set {suffix::description::MVP+} to "&7Obtainable through the Aurora Donor Package with /buy"
			set {suffix::description::Maestro} to "&7Obtainable through the Aurora Donor Package with /buy"
			set {suffix::description::new} to "&7Obtained when you first joined the server"
