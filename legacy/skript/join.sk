on first join:
  add 1 to {joins}
  set join message to "&7[&a+&7] &b&l%player% &bhas joined for Auroramines for the first time &7[&b##%{joins}%&7]"

on join:
  if player has played before:
    set join message to "&7[&a+&7] &7&l%player% &7has joined"

on quit:
  set quit message to "&7[&c-&7] &7&l%player% &7has quit"

on death of player:
  if attacker exists:
    set death message to "&7[&c☠&7] &7&l%victim% &7has died to &7&l%attacker's display name%"
    wait 3 tick
    force victim to respawn
    teleport victim to {spawn}
  else:
    set death message to "&7[&c☠&7] &7&l%victim% &7has died"
    wait 3 tick
    force victim to respawn
    teleport victim to {spawn}