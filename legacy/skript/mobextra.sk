# Mob Regions

on skeleton move:
	if name of event-entity is "&e&lGormak's Bowman":
		if "%region at event-entity%" does not contain "mobgormakbowman":
			teleport event-entity to location(-222, -60, 39, world "world")
	else if name of event-entity is "&e&lArachne's Skeletal Summon":
		if "%region at event-entity%" does not contain "mobarachneskeletal":
			teleport event-entity to location(-184.5, -16, 258.5, world "world")
on husk move:
	if name of event-entity is "&7&lMinion of Gormak":
		if "%region at event-entity%" does not contain "mobgormakminion":
			teleport event-entity to location(-225, -60, -12, world "world")
	else if name of event-entity is "&e&lGormak's Guard":
		if "%region at event-entity%" does not contain "mobgormakguard":
			teleport event-entity to location(-280, -60, 38, world "world")
	else if name of event-entity is "&e&lGormak The Ancient One":
		if "%region at event-entity%" does not contain "mobgormakguard":
			teleport event-entity to location(-280, -60, 38, world "world")

on cave spider move:
	if name of event-entity is "&2&lToxic Weaverling":
		if "%region at event-entity%" does not contain "mobarachneweaverling":
			teleport event-entity to location(-234.5, -30, 243.5, world "world")

on spider move:
	if name of event-entity is "&f&lSilk Spindler":
		if "%region at event-entity%" does not contain "mobarachnesilk":
			teleport event-entity to location(-202.5, -29, 262.5, world "world")
	else if name of event-entity is "&e&lArachne The Crimson Widow":
		if "%region at event-entity%" does not contain "mobarachneskeletal":
			teleport event-entity to location(-184.5, -16, 258.5, world "world")

on pillager move:
	if name of event-entity is "&f&lPillager Scout":
		if "%region at event-entity%" does not contain "mobpillagerscout":
			teleport event-entity to location(-322.5, -23, -295.5, world "world")

on vindicator move:
	if name of event-entity is "&7&lVindicator":
		if "%region at event-entity%" does not contain "mobpillagervindicator":
			teleport event-entity to location(-280.5, -24, -301.5, world "world")

on evoker move:
	if name of event-entity is "&e&lEvoker":
		if "%region at event-entity%" does not contain "mobpillagerevoker":
			teleport event-entity to location(-279.5, -24, -249.5, world "world")


# Extras

on damage of player by cave spider:
	if attacker's display name is "&2&lToxic Weaverling":
		apply poison 3 without particles to victim for 3 second

on projectile hit:
	if shooter is not a player:
		if victim is not a player:
			cancel event
on damage:
	if damage cause is suffocation:
		cancel event

on damage:
	if damage cause is fall:
		if victim is not a player:
			cancel event

on projectile hit:
	if event-projectile is arrow:
		delete event-projectile

# Passes

on right click with paper:
	if name of event-item is "&6&lGormak Pass":
		set {gormakPass::%player's uuid%} to true
		send "&eYou can now enter the Gormak Portal" to player
		remove 1 paper named "&6&lGormak Pass" from player
	else if name of event-item is "<##9DC183>&lArachne Pass":
		set {arachnePass::%player's uuid%} to true
		send "&eYou can now enter the Arachne Portal" to player
		remove 1 of event-item from player
	else if name of event-item is "&f&lPillager Pass":
		set {pillagerPass::%player's uuid%} to true
		send "&eYou can now enter the Pillager Portal" to player
		remove 1 of event-item from player

# Portals

on region enter:
	wait 1 tick
	if "%region at player%" contains "gormakportal":
		if {gormakPass::%player's uuid%} is true:
			teleport player to {warpGormak}
			send "&7Teleporting to Gormak" to player
		else:
			set {_block} to location of block below player
			set {_v} to vector between {_block} and player
			send "&eYou must buy a Gormak Pass" to player
			push player {_v} with speed 1
	else if "%region at player%" contains "arachneportal":
		if {arachnePass::%player's uuid%} is true:
			teleport player to {warpArachne}
			send "&7Teleporting to Arachne" to player
		else:
			set {_block} to location of block below player
			set {_v} to vector between {_block} and player
			send "&eYou must buy an Arachne Pass" to player
			push player {_v} with speed 1
	else if "%region at player%" contains "pillagerportal":
		if {pillagerPass::%player's uuid%} is true:
			teleport player to {warpPillager}
			send "&7Teleporting to Pillager" to player
		else:
			set {_block} to location of block below player
			set {_v} to vector between {_block} and player
			send "&eYou must buy a Pillager Pass" to player
			push player {_v} with speed 1

# CustomItem Function

function deleteFirst(text: text)::text:
  set {_size} to length of {_text}
  set {_remaining} to last ({_size} - 1) characters of {_text}
  return {_remaining}

function customItem(i: itemtype, name: text, t: text, amt: number, p: player, sharp: number = 0, loot: number = 0, dmg: number = 0):
  set {_i}'s name to {_name}
  set {_i} to unbreakable {_i} with all flags hidden
  if {_t} is "key":
    set {_i}'s lore to deleteFirst("a&8🔑 Boss Key") and "&eRight click to summon boss" and " " and "&a&lOverworld🌎"
    enchant {_i} with mending
    give {_amt} of {_i} to {_p}
    send "&7You obtained %{_name}%" to {_p}
  else if {_t} is "loot":
    set {_i}'s lore to "&8💎 Loot Piece" and " " and "&a&lOverworld🌎"
    give {_amt} of {_i} to {_p}
  else if {_t} is "rare":
    set {_i}'s lore to "&8💎 Rare Loot Piece" and " " and "&a&lOverworld🌎"
    enchant {_i} with mending
    give {_amt} of {_i} to {_p}
    send "&7You obtained %{_name}%" to {_p}
  else if {_t} is "combat":
    set {_i}'s lore to "&8🗡 Rare Combat Tool" and " " and "&7Sharpness %{_sharp}%" and "&7Looting %{_loot}%" and " " and "&c+%{_dmg}%" and "&a&lOverworld🌎"
    enchant {_i} with ("sharpness %{_sharp}%" parsed as enchantment type)
    enchant {_i} with ("looting %{_loot}%" parsed as enchantment type)
    if {_name} is "&x&F&7&9&7&1&E&lG&x&F&8&9&C&1&C&lO&x&F&8&A&0&1&9&lR&x&F&9&A&4&1&7&lM&x&F&A&A&9&1&5&lA&x&F&A&A&E&1&3&lK&x&F&B&B&2&1&0&l'&x&F&B&B&7&0&E&lS&x&F&C&B&B&0&C &x&F&D&C&0&0&9&lB&x&F&D&C&5&0&7&lL&x&F&E&C&9&0&5&lA&x&F&F&C&E&0&3&lD&x&F&F&D&2&0&0&lE":
      enchant {_i} with fire aspect 5
      set {_i}'s lore to "&8🗡 Rare Combat Tool" and " " and "&7Sharpness %{_sharp}%" and "&7Looting %{_loot}%" and "&7Fire Aspect 5" and " " and "&c+%{_dmg}%" and "&a&lOverworld🌎"
    give {_amt} of {_i} to {_p}
    send "&7You obtained %{_name}%" to {_p}

command /bar <text>:
  trigger:
    set {barPillager} to boss bar with id "pillager_bar" with title "Pillager Captain" with color white with progress 100
    set bar style of {barPillager} to segmented 20
    set {ravagerExists} to false
    set {barGormak} to boss bar with id "gormak_bar" with title "Gormak The Ancient One" with color yellow with progress 100
    set bar style of {barGormak} to segmented 20
    set {gormakExists} to false
    set {barArachne} to boss bar with id "arachne_bar" with title "Arachne The Crimson Widow" with color lime with progress 100
    set bar style of {barArachne} to segmented 20
    set {arachneExists} to false