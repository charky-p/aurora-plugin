#essence

on break:
	if {essence::%player's uuid%} is not set:
		set {essence::%player's uuid%} to 0
	else:
		set {_int1} to a random integer between 1 and 1000
		set {_int2} to a random integer between 1 and 3
		if {_int1} >= 1000:
			add {_int2} to {essence::%player's uuid%}
			send "&bYou found &l%{_int2}% &r&bof 🔥 Essence"

command /shop:
	trigger:
		set {_gui} to a new chest inventory with 3 row named "Shop"
		set slot 13 of {_gui} to 1 nametag of mending with all flags hidden named "&bRanks"
		open {_gui} to player

on inventory click:
	if name of event-inventory is "Shop":
		if clicked inventory is not player's inventory:
			cancel event
			if index of event-slot is 13:
				set {_gui} to a new chest inventory with 5 rows named "&bRanks"
				open {_gui} to player
				set {_n} to 0
				loop 9 times:
					set slot {_n} of {_gui} to black stained glass pane
					add 1 to {_n}
				loop 3 times:
					set slot {_n} of {_gui} to black stained glass pane
					add 8 to {_n}
					set slot {_n} of {_gui} to black stained glass pane
					add 1 to {_n}
				loop 9 times:
					set slot {_n} of {_gui} to black stained glass pane
					add 1 to {_n}
				set slot 20 of {_gui} to nametag of mending with all flags hidden named "&9&lAdvanced Rank" with lore "&eCost: &b500 Essence"
				set slot 21 of {_gui} to nametag
			if index of event-slot is 0:
				if {coins::%player's uuid%} > 100:
					send "&eYou bought 8x Cobblestone!"
					give 8 cobblestone to player
					subtract 100 from {coins::%player's uuid%}
				else:
					send "&eYou do not have enough coins for that"
	else if name of event-inventory is "&bRanks":
		if clicked inventory is not player's inventory:
			cancel event
			if index of event-slot is 20:
				if {rank::advanced::%player's uuid%} is not set:
					if {essence::%player's uuid%} >= 500:
						subtract 500 from {essence::%player's uuid%}
						close player's inventory
						send "&9&lAdvanced Rank &ehas been acquired for &b500 Essence"
						set {rank::advanced::%player's uuid%} to true
					else:
						send "&eYou do not have enough essence for that"
				else if {rank::advanced::%player's uuid%} is true:
					send "&eYou already have that"
