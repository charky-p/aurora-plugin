on fish:
	if fish state = caught fish:
		set item of fishing caught entity to air
		set {_fish} to random integer between 1 to 100
		set {_luck modifier} to level of luck of the sea of player's tool
		set {_fishcondition} to {_fish} + {_luck modifier}
		if lore of player's held item is "&3Beginner Rod":
			if {_fishcondition} is more or equal to 100: #0% chance w/o luck of the sea
				give player 1 salmon named "&6Blackfin Tuna"
				send "&6&lYou caught a Rare Fish!" to player
			else if {_fishcondition} is more or equal to 80: #20% chance w/o luck of the sea
				give player 1 cod named "&8Black Bass"
			else if {_fishcondition} is more or equal to 50: #30% chance w/0 luck of the sea
				give player 1 cod named "&7Catfish"
			else: #remaining chance, 50% w/o luck of the sea
				give player 1 rotten flesh named "&8Junk"
		else if lore of player's held item is "&3Novice Rod":
			if {_fishcondition} is more or equal to 105: #0% chance w/5
				give player 1 pufferfish named "&6Black Spotted Pufferfish"
				send "&6&lYou caught a Rare Fish!" to player
			else if {_fishcondition} is more or equal to 95: #10% chance w/5
				give (random integer between 1 to 2)*(level of fortune of player's tool)+1 of cod named "&8Sea Trout" to player
			else if {_fishcondition} is more or equal to 45: #50% chance w/5
				give (random integer between 1 to 3)*(level of fortune of player's tool)+1 of salmon named "&7Pink Salmon" to player
			else: #remaining chance, 40% w/5
				give player 1 rotten flesh named "&8Junk"

on fish:
	if fish state = caught fish:
		chance of 0.05%:
			give player golden nugget named "Treasure"

#Luck of the sea = lvl 30, 30%,40%,30%
#Draw a bar with the values, and minus lvl of luck of sea from each to find new chances







