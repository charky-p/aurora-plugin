# Blast

on break: #Cross Shape Mining
	if lore of player's tool contains "&7Blast 1":
		set {_1} to location of event-block
		set {_2} to location of event-block
		set {_3} to location of event-block
		set {_4} to location of event-block
		if player's pitch is between -50 and 50:
			add 1 to y-coord of {_1}
			subtract 1 from y-coord of {_2}
			if player's horizontal facing is west or east:
				add 1 to z-coord of {_3}
				subtract 1 from z-coord of {_4}
				loop blocks at {_1},{_2},{_3} and {_4}:
					if regionContains("%region at loop-block%") is true:
						if loop-block is not air:
							mining("%type of loop-block%", player)
							set loop-block to air
			else if player's horizontal facing is north or south:
				add 1 to x-coord of {_3}
				subtract 1 from x-coord of {_4}
				loop blocks at {_1},{_2},{_3} and {_4}:
					if regionContains("%region at loop-block%") is true:
						if loop-block is not air:
							mining("%type of loop-block%", player)
							set loop-block to air
		else:
			add 1 to x-coord of {_1}
			add 1 to z-coord of {_3}
			subtract 1 from x-coord of {_2}
			subtract 1 from z-coord of {_4}
			loop blocks at {_1},{_2},{_3} and {_4}:
				if regionContains("%region at loop-block%") is true:
					if loop-block is not air:
						mining("%type of loop-block%", player)
						set loop-block to air

on break: #3x3x1 Mining
	if lore of player's tool contains "&7Blast 2":
		set {_1} to location of event-block
		set {_2} to location of event-block
		if player's pitch is between -50 and 50:
			add 1 to y-coord of {_1}
			subtract 1 from y-coord of {_2}
			if player's horizontal facing is west or east:
				add 1 to z-coord of {_1}
				subtract 1 from z-coord of {_2}
				loop blocks within {_1} and {_2}:
					if regionContains("%region at loop-block%") is true:
						if loop-block is not air:
							if loop-block is not event-block:
								mining("%type of loop-block%", player)
								set loop-block to air
			else if player's horizontal facing is north or south:
				add 1 to x-coord of {_1}
				subtract 1 from x-coord of {_2}
				loop blocks within {_1} and {_2}:
					if regionContains("%region at loop-block%") is true:
						if loop-block is not air:
							if loop-block is not event-block:
								mining("%type of loop-block%", player)
								set loop-block to air
		else:
			add 1 to x-coord of {_1}
			add 1 to z-coord of {_1}
			subtract 1 from x-coord of {_2}
			subtract 1 from z-coord of {_2}
			loop blocks within {_1} and {_2}:
				if regionContains("%region at loop-block%") is true:
					if loop-block is not air:
						if loop-block is not event-block:
							mining("%type of loop-block%", player)
							set loop-block to air

on break: #3x3x3 Mining
	if lore of player's tool contains "&7Blast 3":
		set {_1} to location of event-block
		set {_2} to location of event-block
		add 1 to y-coord of {_1}
		subtract 1 from y-coord of {_2}
		add 1 to z-coord of {_1}
		subtract 1 from z-coord of {_2}
		add 1 to x-coord of {_1}
		subtract 1 from x-coord of {_2}
		loop blocks within {_1} and {_2}:
			if regionContains("%region at loop-block%") is true:
				if loop-block is not air:
					if loop-block is not event-block:
						mining("%type of loop-block%", player)
						set loop-block to air

function regionContains(search: text)::boolean:
	loop {mineRegions::*}:
		if "%{_search}%" contains loop-value:
			return true
	return false

command /region <text>:
	trigger:
		set {mineRegions::*} to "stone in world world"
		send "%{mineRegions::*}%"
