#Autocompressor
#Mechanics of Autocompressor
on inventory slot change:
	if player has scoreboard tag "AutoComp":
		if player has 64 cobblestone named "&eCobblestone":
			remove 64 cobblestone named "&eCobblestone" from player
			give 1 of cobblestone of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eCobblestone" to player
		else if player has 64 coal named "&eCoal":
			remove 64 coal named "&eCoal" from player
			give 1 of coal of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eCoal" to player
		else if player has 64 iron ingot named "&eIron Ingot":
			remove 64 iron ingot named "&eIron Ingot" from player
			give 1 of iron ingot of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eIron" to player
		else if player has 64 gold ingot named "&eGold Ingot":
			remove 64 gold ingot named "&eGold Ingot" from player
			give 1 of gold ingot of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eGold" to player
		else if player has 64 diamond named "&eDiamond":
			remove 64 diamond named "&eDiamond" from player
			give 1 of diamond of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eDiamond" to player
		else if player has 64 redstone named "&eRedstone":
			remove 64 redstone named "&eRedstone" from player
			give 1 of redstone of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eRedstone" to player
		else if player has 64 lapis named "&eLapis":
			remove 64 lapis named "&eLapis" from player
			give 1 of lapis of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eLapis" to player
		else if player has 64 emerald named "&eEmerald":
			remove 64 emerald named "&eEmerald" from player
			give 1 of emerald of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eEmerald" to player
		else if player has 64 copper ingot named "&eCopper":
			remove 64 copper ingot named "&eCopper" from player
			give 1 of copper ingot of mending with all flags hidden named "&7[&lCOMPRESSED&7] &eCopper" to player

on inventory slot change:
	if player has scoreboard tag "SuperAutoComp":
		if player has 64 cobblestone named "&7[&lCOMPRESSED&7] &eCobblestone":
			remove 64 cobblestone named "&7[&lCOMPRESSED&7] &eCobblestone" from player
