		else if player has 64 coal named "&7[&lCOMPRESSED&7] &eCoal":
			remove 64 coal named "&7[&lCOMPRESSED&7] &eCoal" from player
			give 1 of coal of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eCoal" to player
		else if player has 64 iron ingot named "&7[&lCOMPRESSED&7] &eIron":
			remove 64 iron ingot named "&7[&lCOMPRESSED&7] &eIron" from player
			give 1 of iron ingot of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eIron" to player
		else if player has 64 gold ingot named "&7[&lCOMPRESSED&7] &eGold":
			remove 64 gold ingot named "&7[&lCOMPRESSED&7] &eGold" from player
			give 1 of gold ingot of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eGold" to player
		else if player has 64 diamond named "&7[&lCOMPRESSED&7] &eDiamond":
			remove 64 diamond named "&7[&lCOMPRESSED&7] &eDiamond" from player
			give 1 of diamond of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eDiamond" to player
		else if player has 64 redstone named "&7[&lCOMPRESSED&7] &eRedstone":
			remove 64 redstone named "&7[&lCOMPRESSED&7] &eRedstone" from player
			give 1 of redstone of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eRedstone" to player
		else if player has 64 lapis named "&7[&lCOMPRESSED&7] &eLapis":
			remove 64 lapis named "&7[&lCOMPRESSED&7] &eLapis" from player
			give 1 of lapis of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eLapis" to player
		else if player has 64 emerald named "&7[&lCOMPRESSED&7] &eEmerald":
			remove 64 emerald named "&7[&lCOMPRESSED&7] &eEmerald" from player
			give 1 of emerald of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eEmerald" to player
		else if player has 64 copper ingot named "&7[&lCOMPRESSED&7] &eCopper":
			remove 64 copper ingot named "&7[&lCOMPRESSED&7] &eCopper" from player
			give 1 of copper ingot of mending with all flags hidden named "&7[&2&lSUPER COMPRESSED&7] &eCopper" to player

#Activation of Autocompressor
on right click holding paper:
	if player has paper named "&2Auto Compressor":
		remove 1 paper named "&2Auto Compressor" from player
		make console execute command "/tag %player% add AutoComp"
		send "&eAuto Compressor Activated!, to deactivate do /auto comp" to player
		make console execute command "/tag %player% add AutoCompPermission"
		set {UnlockedAutoComp} to true

on right click holding paper:
	if player has paper named "&2Super Auto Compressor":
		remove 1 paper named "&2Super Auto Compressor" from player
		make console execute command "/tag %player% add SuperAutoComp"
		send "&eSuper Auto Compressor Activated!, to deactivate do /auto super" to player
		make console execute command "/tag %player% add SuperAutoCompPermission"
		set {UnlockedSuperAutoComp} to true

#Command Activation
command /auto <text>:
	cooldown: 3 seconds
	cooldown message: you need to wait 3 seconds before using this
	trigger:
		if arg-1 is "comp":
			if player has scoreboard tag "AutoCompPermission":
				if {UnlockedAutoComp} is true:
					make console execute command "/tag %player% remove AutoComp"
					send "&eAuto Compressor Deactivated!, to reactivate do /auto comp" to player
					set {UnlockedAutoComp} to false

				else if {UnlockedAutoComp} is false:
					make console execute command "/tag %player% add AutoComp"
					send "&eAuto Compressor Activated!, to deactivate do /auto comp" to player
					set {UnlockedAutoComp} to true
		else if arg-1 is "super":
			if player has scoreboard tag "SuperAutoCompPermission":
				if {UnlockedSuperAutoComp} is true:
					make console execute command "/tag %player% remove SuperAutoComp"
					send "&eSuper Auto Compressor Deactivated!, to reactivate do /auto super" to player
					set {UnlockedSuperAutoComp} to false

				else if {UnlockedSuperAutoComp} is false:
					make console execute command "/tag %player% add SuperAutoComp"
					send "&eSuper Auto Compressor Activated!, to deactivate do /auto super" to player
					set {UnlockedSuperAutoComp} to true
		else:
			send "&eYou do not have permission, Buy an Auto Compressor at /spawn"

