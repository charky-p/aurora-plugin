#farming
on break:
	if event-block is wheat:
		if player's tool is hoe:
			give 1+(random integer between 1 and 3)*(level of fortune on player's tool) of wheat to player
			wait 8 seconds
			set event-block to stage 8 wheat plant
		else:
			cancel event

#Golden Clicker
on click:
	if player is holding a golden nugget named "&6Golden Clicker":
		give player 1 golden nugget named "&6Token"

#Custom Enchants, Haste, Blast, Strenght, Valor, etc
on mine:
	if lore of player's held item contains "&eHaste I":
		remove haste from player
		apply haste 1 to the player for 3 seconds

#inventory full msg
on break:
	if player has enough space for 1 spruce door:
		stop
	else:
		send "&bInventory Full!" to player

#Custom Weapons
on left click holding bow:
	if the 1st line of the lore of the player's tool is "&2Restock I":
		set {_waited} to difference between {cooldown::%player's uuid%::bow} and now
		if {_waited} is less than 30 seconds:
			send "&eOn Cooldown! Try again in %difference between 30 seconds and {_waited}%"
			stop
		else:
			send "&7[&2Restock I&7] &eYou recieved arrows" to player
			give 4 arrow named "&eArrow" to player
			set {cooldown::%player's uuid%::bow} to now
			wait 30 seconds
			remove 4 arrow named "&eArrow" from player
	else if the 1st line of the lore of the player's tool is "&2Restock II":
		set {_waited} to difference between {cooldown::%player's uuid%::bow} and now
		if {_waited} is less than 25 seconds:
			send "&eOn Cooldown! Try again in %difference between 25 seconds and {_waited}%"
			stop
		else:
			send "&7[&2Restock II&7] &eYou recieved arrows" to player
			give 5 arrow named "&eArrow" to player
			set {cooldown::%player's uuid%::bow} to now
			wait 25 seconds
			remove 5 arrow named "&eArrow" from player

on join:
	make player execute command "/spawn"



