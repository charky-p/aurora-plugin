#commands
command /warp <text>:
	usage: /warp <boss>, e.g. /warp gormak
	permission: op
	trigger:
		if arg-1 is "gormak":
			if player has scoreboard tag "WarpGormakPerm":
				teleport player to {warpGormak}
				send "&bTeleporting to Gormak..." to player
			else:
				send "&bYou do not have Gormak's Pass" to player
		else if arg-1 is "arachne":
			teleport player to {warpArachne}
			send "&bTeleporting to Arachne..." to player
		else if arg-1 is "pillager":
			teleport player to {warpPillager}
			send "&bTeleporting to Pillager..." to player

command /spawn:
	trigger:
		teleport player to {spawn}
		send "&bTeleporting to Spawn..." to player

command /setspawn:
	permission: op
	trigger:
		set {_pitch} to player's pitch
		set {_yaw} to player's yaw
		set {spawn} to location at player
		set {spawn}'s pitch to {_pitch}
		set {spawn}'s yaw to {_yaw}
		send "&bSpawn has been set to %{spawn}%" to player

command /trash:
	trigger:
		set {_gui} to chest inventory with 4 row with name "&8&lTrash"
		set slot 35 of {_gui} to red stained glass pane named "&4Close Bin to Remove Items"
		open {_gui} to player

on inventory click:
	if name of event-inventory is "&8&lTrash":
		if index of event-slot = 35:
			if event-item is red stained glass pane:
				cancel event

command /vault [<number>]:
	usage: /v
	aliases: /v
	trigger:
		if arg-1 is not set:
			set {vaults.open.%player%} to 1
			set {_v} to chest inventory with 6 rows with name "&c%player%&7's vault 1"
			open {_v} to player
			wait 1 tick
			set {_num} to 0
			loop {vaults.item.%arg-1%.%player%::*}:
				set slot {_num} of player's current inventory to loop-value
				add 1 to {_num}

on inventory close:
	if {vaults.open.%player%} is set:
		if name of event-inventory contains "vault":
			set {_count} to 0
			wait 1 tick
			loop 54 times:
				set {vaults.item.%{vaults.open.%player%}%.%player%::%{_count}%} to slot {_count} of current inventory of player
				add 1 to {_count}
			delete {vaults.open.%player%}




command /drop:
	trigger:
		if player has scoreboard tag "dropOn":
			make console execute command "/tag %player% remove dropOn"
			send "&bYou can no longer drop items" to player
		else:
			make console execute command "/tag %player% add dropOn"
			send "&bYou can now drop items" to player

on drop:
	if player has scoreboard tag "dropOn":
		stop
	else:
		cancel event


on death of a player:
	force victim to respawn
	wait 1 tick
	teleport victim to {spawn}
	apply night vision to victim for 999999 second

on join:
	apply night vision to player for 999999 second

on break:
	if player has enough space for 1 spruce door:
		stop
	else:
		send "&bInventory Full!" to player

